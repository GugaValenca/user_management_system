DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Preferred: full connection string (Neon/Postgres/MySQL)
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# CORS / CSRF (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database options
# Use sqlite (default) or mysql
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# MySQL (only used when DB_ENGINE=mysql)
DB_NAME=user_management_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# PostgreSQL (only used when DB_ENGINE=postgres and DATABASE_URL is empty)
# DB_ENGINE=postgres
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=
# DB_HOST=your-neon-host.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CHANNEL_BINDING=require

# Production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Frontend URL used to build links inside password reset / verification emails
FRONTEND_URL=http://localhost:3000

# Email delivery (password reset, account verification)
# Defaults to printing emails to the console, which is fine for local dev.
# For production, point this at a real SMTP provider (SendGrid, Mailgun,
# Amazon SES, or even Gmail with an app password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@user-management.local
